{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/dae/fp_lite.schema.json",
  "title": "fp-lite output V2 (BDB Integration)",
  "type": "object",
  "required": [
    "fp_lite_version",
    "facet_levels",
    "regime_code"
  ],
  "properties": {
    "fp_lite_version": {
      "type": "string"
    },
    "facet_levels": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "regime_code": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}